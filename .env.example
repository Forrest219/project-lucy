# Lucy compose / local deploy env example.
# Copy to `.env` and adjust. Do not commit real secrets.

# --- Host publish ports (compose `ports:` left side) ---
LUCY_WEBUI_HOST_PORT=5174
LUCY_PROXY_HOST_PORT=7879

# Demo stack overrides (docker-compose.demo.yml):
# LUCY_DEMO_WEBUI_HOST_PORT=55176
# LUCY_DEMO_PROXY_HOST_PORT=57881
# LUCY_DEMO_MYSQL_HOST_PORT=53306

# --- Advertise (Agent / WebUI copy) ---
# Listen  = LUCY_PROXY_HOST:LUCY_PROXY_PORT inside the container (default 7879)
# Publish = host mapping / Ingress above
# Advertise = this URL — the ONLY value WebUI shows and Agents should copy
#
# Direct host-port publish: PUBLIC must use the host port (same as Publish).
#   Default customer compose: http://127.0.0.1:7879/mcp
#   Default demo compose:     http://127.0.0.1:57881/mcp
# If you remap LUCY_PROXY_HOST_PORT / LUCY_DEMO_PROXY_HOST_PORT, update this too.
#
# Reverse proxy / Ingress / public DNS: set the externally reachable URL;
# Listen/Publish may stay on internal ports.
LUCY_PUBLIC_MCP_URL=http://127.0.0.1:7879/mcp
