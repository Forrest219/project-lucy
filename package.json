    "eval:list": "node scripts/eval-runner.mjs --list-cases",
    "lint:spec": "node scripts/lint-spec.mjs",
    "r1:doris-smoke": "node scripts/lucy-r1-doris-smoke.mjs",
    "r1:doris-smoke:test": "node --test scripts/lucy-r1-doris-smoke.test.mjs",
    "r1:starrocks-smoke": "node scripts/lucy-r1-doris-smoke.mjs --engine starrocks --out inbox/starrocks-r1-evidence.json",
    "r1:hermes-report": "node scripts/lucy-r1-hermes-report.mjs",
    "r1:hermes-report:test": "node --test scripts/lucy-r1-hermes-report.test.mjs",
    "r1:local-gates": "node scripts/lucy-r1-local-gates.mjs",
    "r1:local-gates:test": "node --test scripts/lucy-r1-local-gates.test.mjs",
    "r1:mcp-contract": "node scripts/lucy-r1-mcp-contract-smoke.mjs",
    "r1:mcp-contract:test": "node --test scripts/lucy-r1-mcp-contract-smoke.test.mjs",
    "r1:readiness": "node scripts/lucy-r1-readiness.mjs",
    "r1:readiness:strict": "node scripts/lucy-r1-readiness.mjs --strict",
    "r1:readiness:test": "node --test scripts/lucy-r1-readiness.test.mjs",
    "r1:release-bundle": "node scripts/lucy-r1-release-bundle.mjs",
    "r1:release-bundle:test": "node --test scripts/lucy-r1-release-bundle.test.mjs",
    "r1:status": "node scripts/lucy-r1-status.mjs",
    "r1:status:test": "node --test scripts/lucy-r1-status.test.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "security:baseline": "node scripts/security-baseline.mjs",
    "smoke:p0": "node scripts/p0-smoke.mjs",
    "smoke:p0:docker-entrypoint:test": "node --test scripts/docker-entrypoint.test.mjs",
    "smoke:p0:docker": "node scripts/p0-smoke.mjs --docker",
    "smoke:p0:headless-config": "node scripts/headless-config-smoke.mjs",
    "smoke:p0:customer": "node scripts/p0-customer-path-smoke.mjs",
    "smoke:p0:demo": "node scripts/p0-demo-docker-smoke.mjs",
    "smoke:p0:postgres-demo": "node scripts/p0-postgres-demo-smoke.mjs",
    "smoke:p0:business-eval": "node scripts/p0-business-eval-smoke.mjs",
    "smoke:p1:context": "node scripts/p1-context-smoke.mjs",
    "smoke:p1:skills": "node scripts/p1-skills-smoke.mjs",
    "smoke:p1:endpoint": "node scripts/p1-endpoint-smoke.mjs",
    "smoke:p1:observability": "node scripts/p1-observability-smoke.mjs",
    "e2e:agent": "node scripts/p1-agent-e2e.mjs",
    "e2e:agent:ceo-one-report": "node scripts/p1-agent-e2e.mjs --profile main --suite data_agent_poc --out inbox/ceo-one-report-agent-e2e-evidence.json --html-report inbox/ceo-one-report-agent-e2e-report.html --artifacts inbox/ceo-one-report-agent-e2e-artifacts",
    "e2e:agent:test": "node --test scripts/p1-agent-e2e.test.mjs",
    "e2e:agent:local-hermes": "node scripts/p1-agent-e2e-local-hermes.mjs --replace-existing",
    "e2e:agent:local-hermes:test": "node --test scripts/p1-agent-e2e-local-hermes.test.mjs",
    "e2e:sow-trust-standard": "node scripts/sow-trust-e2e-standard.mjs",
    "package:sow-trust-evidence": "node scripts/package-sow-trust-evidence.mjs",
    "smoke:p1:agent-e2e": "node scripts/p1-agent-e2e.mjs",
    "smoke:p1:agent-e2e:test": "node --test scripts/p1-agent-e2e.test.mjs",
    "smoke:p1:agent-e2e:local-hermes": "node scripts/p1-agent-e2e-local-hermes.mjs --replace-existing",
    "smoke:p1:agent-e2e:local-hermes:test": "node --test scripts/p1-agent-e2e-local-hermes.test.mjs",
    "smoke:p1:business-eval-full": "node scripts/p1-business-eval-full.mjs --require-mcp-token",
    "smoke:p1:starrocks-certification": "node scripts/p1-starrocks-certification.mjs",
    "smoke:p1:release-readiness": "node scripts/p1-release-readiness.mjs",
    "smoke:p1:release-readiness:test": "node --test scripts/p1-release-readiness.test.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  }
}
