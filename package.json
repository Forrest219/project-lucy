{
  "name": "project-lucy-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project Lucy eval runner — wraps Claude Code CLI to exercise KTX MCP tools against evals/superstore/eval cases.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:ktx-diff": "node scripts/ktx-lucy-diff-audit.mjs",
    "compat:ktx-upgrade": "node scripts/ktx-upgrade-compat.mjs",
