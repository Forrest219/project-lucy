{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lucy-real-user-e2e-v1",
  "title": "Lucy real-user E2E release evidence (Spec §8.1)",
  "type": "object",
  "required": ["contract", "executionMode", "stub", "runId", "candidate", "environment", "clients", "manualClients", "summary", "cases", "gates", "serverEvidence", "provenance", "status", "releaseReady"],
  "properties": {
    "contract": { "const": "lucy-real-user-e2e-v1" },
    "executionMode": { "enum": ["release", "collect", "dry_run", "local"] },
    "stub": { "type": "boolean" },
    "runId": { "type": "string", "minLength": 8 },
    "candidate": {
      "type": "object",
      "required": ["gitSha", "treeDigest", "imageDigest", "platform", "ktxVersion", "chartVersion"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeDigest": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platform": { "type": "string", "minLength": 1 },
        "ktxVersion": { "type": "string", "minLength": 1 },
        "chartVersion": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["instanceId", "topology", "fixtureDigest", "profileDigest", "caseCatalogDigest", "deployedImageDigest", "startedAt", "finishedAt"],
      "properties": {
        "instanceId": { "type": "string", "minLength": 1 },
        "topology": { "type": "string", "minLength": 1 },
        "fixtureDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "profileDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "caseCatalogDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "deployedImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "startedAt": { "type": ["string", "null"], "minLength": 10 },
        "finishedAt": { "type": ["string", "null"], "minLength": 10 }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "version", "adapterDigest", "model", "transport", "required"],
        "properties": {
          "product": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "adapterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "model": { "type": "string", "minLength": 1 },
          "transport": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["required", "executed", "passed", "failed", "blocked", "skipped", "dryRun"],
      "properties": {
        "required": { "type": "integer" },
        "executed": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "blocked": { "type": "integer" },
        "skipped": { "type": "integer" },
        "dryRun": { "type": "integer" }
      }
    },
    "manualClients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "execution", "transport", "status", "operator", "completedAt", "runId", "steps", "artifact"],
        "properties": {
          "product": { "type": "string", "minLength": 1 },
          "execution": { "enum": ["manual"] },
          "transport": { "enum": ["gui"] },
          "status": { "enum": ["passed", "failed", "blocked", "skipped", "dry_run"] },
          "operator": { "type": "string", "minLength": 1 },
          "completedAt": { "type": "string", "minLength": 10 },
          "runId": { "type": "string", "minLength": 1 },
          "productVersion": { "type": "string" },
          "notes": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "passed", "evidencePath", "evidenceSha256"],
              "properties": {
                "id": { "type": "string", "pattern": "^M-0[1-5]$" },
                "passed": { "type": "boolean" },
                "evidencePath": { "type": "string", "pattern": "^results/manual/[A-Za-z0-9_\\-./]+$" },
                "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "notes": { "type": "string" }
              }
            }
          },
          "artifact": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "signature": {
            "type": "object",
            "properties": {
              "algorithm": { "type": "string" },
              "publicKey": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "runner", "status", "startedAt", "finishedAt", "serverTraceIds", "queryEventIds", "policyVersion", "contextPolicyVersion", "assertions", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "runner": { "enum": ["security", "management", "agent", "gate"] },
          "client": { "type": "string" },
          "run": { "type": "integer" },
          "status": { "enum": ["passed", "failed", "blocked", "skipped", "dry_run"] },
          "startedAt": { "type": "string" },
          "finishedAt": { "type": "string" },
          "tokenFingerprint": { "type": "string" },
          "tokenFingerprints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "serverTraceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "queryEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "policyVersion": { "type": "string", "minLength": 1 },
          "contextPolicyVersion": { "type": "string", "minLength": 1 },
          "policyVersions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "contextPolicyVersions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "goldDigest": { "type": "string" },
          "resultDigest": { "type": "string" },
          "denyReason": { "type": "string" },
          "upstreamExecutions": { "type": "integer" },
          "failureClass": { "enum": ["product_defect", "semantic_definition", "model_variance", "environment"] },
          "leakage": {
            "type": "object",
            "required": ["scanned", "hits"],
            "properties": { "scanned": { "type": "boolean" }, "hits": { "type": "integer" } }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["token", "passed"],
              "properties": { "token": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" }, "detail": { "type": "string" } }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
            }
          },
          "asks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["runId", "instanceId", "caseId", "askIndex", "agentId", "tokenFingerprint", "since", "until", "traceIds", "queryEventIds", "policyVersion", "contextPolicyVersion", "resultDigest", "goldDigest"],
              "properties": {
                "runId": { "type": "string", "minLength": 1 },
                "instanceId": { "type": "string", "minLength": 1 },
                "caseId": { "type": "string", "minLength": 1 },
                "client": { "type": ["string", "null"] },
                "run": { "type": ["integer", "null"] },
                "askIndex": { "type": "integer", "minimum": 0 },
                "agentId": { "type": "string", "minLength": 1 },
                "goldKey": { "type": ["string", "null"] },
                "expectation": { "enum": ["answer", "denied"] },
                "since": { "type": "string", "minLength": 10 },
                "until": { "type": "string", "minLength": 10 },
                "traceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "queryEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "events": { "type": "array" },
                "tokenFingerprint": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                "policyVersion": { "type": "string", "minLength": 1 },
                "contextPolicyVersion": { "type": "string", "minLength": 1 },
                "bindingProblems": { "type": "array", "items": { "type": "string" } },
                "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "goldDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "sessionId": { "type": "string" },
                "model": { "type": "string" },
                "answer": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["contextMigrationPending", "projectionBacklog", "existing"],
      "properties": {
        "contextMigrationPending": { "type": "integer" },
        "projectionBacklog": { "type": "integer" },
        "existing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "imageDigest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed", "blocked", "skipped", "dry_run"] },
              "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "serverEvidence": {
      "type": "object",
      "required": ["source", "path", "sha256"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["trusted", "runner"],
      "properties": {
        "trusted": { "type": "boolean" },
        "runner": { "type": "string", "minLength": 1 },
        "ciRunId": { "type": "string" },
        "ciSha": { "type": "string" },
        "workflow": { "type": "string" }
      }
    },
    "status": { "enum": ["passed", "failed", "blocked", "skipped", "dry_run"] },
    "releaseReady": { "type": "boolean" }
  }
}
