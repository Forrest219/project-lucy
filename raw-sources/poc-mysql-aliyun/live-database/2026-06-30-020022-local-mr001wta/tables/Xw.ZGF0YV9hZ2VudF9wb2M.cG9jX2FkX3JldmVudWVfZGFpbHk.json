{
  "catalog": null,
  "db": "data_agent_poc",
  "name": "poc_ad_revenue_daily",
  "kind": "table",
  "comment": "何洲场景：FineVis 营业收入-广告模拟日表，按日期、广告位、国家记录收入、曝光、广告域 DAU",
  "estimatedRows": 604,
  "columns": [
    {
      "name": "dt",
      "nativeType": "date",
      "normalizedType": "date",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": true,
      "comment": "统计日期，日粒度，北京时间自然日"
    },
    {
      "name": "position_name",
      "nativeType": "varchar",
      "normalizedType": "varchar",
      "dimensionType": "string",
      "nullable": false,
      "primaryKey": true,
      "comment": "广告位名称，例如开屏、天气首页中部、信息流、详情页"
    },
    {
      "name": "country",
      "nativeType": "varchar",
      "normalizedType": "varchar",
      "dimensionType": "string",
      "nullable": false,
      "primaryKey": true,
      "comment": "国家或区域，默认国内；用于区分国内和国际广告业务"
    },
    {
      "name": "ad_revenue",
      "nativeType": "decimal",
      "normalizedType": "decimal",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "广告收入，单位：元；何洲 FineVis 广告经营场景核心收入指标"
    },
    {
      "name": "ad_impressions",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "广告曝光量，单位：次；用于计算 eCPM"
    },
    {
      "name": "ad_dau",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "广告域 DAU/货币化 DAU，单位：人；不同于产品活跃 DAU，来源可能为友盟三端，待 owner 确认"
    },
    {
      "name": "arpu_check",
      "nativeType": "decimal",
      "normalizedType": "decimal",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "广告 ARPU 校验列，单位：元/人；仅供 eval 校验，正式 measure 暂定 sum(ad_revenue)/sum(ad_dau)，ARPU 双公式待确认"
    },
    {
      "name": "ecpm_check",
      "nativeType": "decimal",
      "normalizedType": "decimal",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "eCPM 校验列，单位：元/千次曝光；仅供 eval 校验，正式 measure 使用 sum(ad_revenue)/sum(ad_impressions)*1000 重算"
    },
    {
      "name": "seed_scenario",
      "nativeType": "varchar",
      "normalizedType": "varchar",
      "dimensionType": "string",
      "nullable": true,
      "primaryKey": false,
      "comment": "造数场景标记，例如开屏 eCPM 最高、信息流收入最高"
    },
    {
      "name": "created_at",
      "nativeType": "timestamp",
      "normalizedType": "timestamp",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": false,
      "comment": "记录创建时间"
    },
    {
      "name": "updated_at",
      "nativeType": "timestamp",
      "normalizedType": "timestamp",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": false,
      "comment": "记录最近更新时间"
    }
  ],
  "foreignKeys": []
}
