{
  "catalog": null,
  "db": "data_agent_poc",
  "name": "poc_app_active_daily",
  "kind": "table",
  "comment": "牛玉婷场景：FineBI 活跃分析模拟日表，按日期和包名记录 DAU 与启动次数",
  "estimatedRows": 453,
  "columns": [
    {
      "name": "dt",
      "nativeType": "date",
      "normalizedType": "date",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": true,
      "comment": "统计日期，日粒度，北京时间自然日"
    },
    {
      "name": "pkg_name",
      "nativeType": "varchar",
      "normalizedType": "varchar",
      "dimensionType": "string",
      "nullable": false,
      "primaryKey": true,
      "comment": "包名或客户端名称，例如墨迹天气_Android、墨迹天气_iPhone、墨迹天气_Harmony"
    },
    {
      "name": "dau_noback",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "DAU 不含刷新，单位：人；对应 app_aty_user_cnt_1d_noback，iPhone 端不含后台启动"
    },
    {
      "name": "dau_with_back",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "DAU 含刷新，单位：人；对应 app_aty_user_cnt_1d，用于与不含刷新口径对比"
    },
    {
      "name": "start_cnt_noback",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "日启动次数不含刷新，单位：次；对应 app_start_cnt_1d_noback"
    },
    {
      "name": "start_cnt_with_back",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "日启动次数含刷新，单位：次；对应 app_start_cnt_1d"
    },
    {
      "name": "avg_start_cnt_check",
      "nativeType": "decimal",
      "normalizedType": "decimal",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "人均启动次数校验列，单位：次/人；仅供 eval 校验，正式 measure 使用 sum(start_cnt_noback)/sum(dau_noback) 重算"
    },
    {
      "name": "seed_scenario",
      "nativeType": "varchar",
      "normalizedType": "varchar",
      "dimensionType": "string",
      "nullable": true,
      "primaryKey": false,
      "comment": "造数场景标记，例如 Android 下降、Harmony 增长、iPhone 稳定"
    },
    {
      "name": "created_at",
      "nativeType": "timestamp",
      "normalizedType": "timestamp",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": false,
      "comment": "记录创建时间"
    },
    {
      "name": "updated_at",
      "nativeType": "timestamp",
      "normalizedType": "timestamp",
      "dimensionType": "time",
      "nullable": false,
      "primaryKey": false,
      "comment": "记录最近更新时间"
    }
  ],
  "foreignKeys": []
}
