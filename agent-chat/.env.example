# Optional Agent Chat (A3) environment — copy to agent-chat/.env and fill values.
# Never commit the real .env. See docs/runbook-lucy-agent-chat-a3.md.

# --- L2: Open WebUI → Hermes API Server (must differ from L3) ---
API_SERVER_KEY=change-me-generate-with-openssl-rand-hex-32
API_SERVER_MODEL_NAME=lucy-data-agent

# --- L3: Hermes → Lucy MCP (Admin Token 首秀 plaintext, once) ---
# Prefer the runtime Public MCP URL from Lucy (LUCY_PUBLIC_MCP_URL / GET /api/project.mcpEndpoint).
# From Hermes container to Lucy on the Docker host, host.docker.internal is typical for local verify.
LUCY_PUBLIC_MCP_URL=http://host.docker.internal:7879/mcp
LUCY_AGENT_TOKEN=replace-with-lucy-agent-bearer-token

# --- LLM provider (Hermes only; pick one your Hermes model config uses) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional image / port overrides ---
# HERMES_IMAGE=nousresearch/hermes-agent:latest
# OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
AGENT_CHAT_WEBUI_HOST_PORT=3000
OPEN_WEBUI_NAME=Lucy Agent Chat
