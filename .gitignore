# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Cursor skill packaging artifacts (keep skill dirs; ignore zip exports)
.cursor/skills/*.zip

# KTX runtime state (daemon pid, ports, logs, transient config)
ktx.yaml
!customer-config.example/ktx.yaml
.ktx/logs/
.ktx/runtime/
.ktx/mcp.json

# Secrets — never commit; ktx.yaml references via file: URI
.ktx/secrets/
secrets/
customer-config/
!customer-config.example/.ktx/
!customer-config.example/.ktx/secrets/
!customer-config.example/.ktx/secrets/.gitignore

# temp scratch space
temp/
dev-inbox/
inbox/
release/
var/screenshots/
var/logs/
output/
tmp/

# Build / dependency outputs (webui ships its own .gitignore, this is the root fallback)
node_modules/
dist/
*.tsbuildinfo

# Python / venv (KTX curator tooling uses them locally)
__pycache__/
*.pyc
.venv/
venv/
.ktx-ui/
!customer-config.example/.ktx-ui/
!customer-config.example/.ktx-ui/.gitkeep
inbox/20260809-gate-c-uat/.tokens.local
