#!/usr/bin/env bash
# Repository pre-commit hook (stock macOS bash 3.2 compatible).
# Installed via: npm run hooks:install  (git config core.hooksPath .githooks)
# Emergency bypass: LUCY_SKIP_HOOKS=1 git commit ...

set -euo pipefail

if [ "${LUCY_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-commit] LUCY_SKIP_HOOKS=1 — skipping pre-commit checks."
  exit 0
fi

# Ensure node/npm are reachable in GUI git clients on macOS.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "[pre-commit] checking staged files..."

# 1. Secret & private runtime file guard (blocking)
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .ktx/secrets/*|*/.ktx/secrets/*|webui/config/access.yaml|*/webui-bootstrap-token|webui-bootstrap-token)
      echo "[pre-commit] FAIL: forbidden private/secret file staged: $f" >&2
      exit 1
      ;;
  esac
done <<EOF
$STAGED_FILES
EOF

if git diff --cached -U0 -- . ':!*.test.*' ':!*.spec.*' ':!docs/*' ':!inbox/*' \
  | grep -E '^\+.*(-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})' >/dev/null 2>&1; then
  echo "[pre-commit] FAIL: potential private key or token detected in staged diff." >&2
  exit 1
fi

# 2. Path-scoped fast lints
run_skip_ledger=0
run_server_sync_io=0
run_webui_tsx_lints=0
run_yaml_alias=0
run_spec_docs=0
run_version_ledger=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    webui/src/*|webui/server/*|webui/tests/*|scripts/*)
      run_skip_ledger=1
      ;;
  esac
  case "$f" in
    webui/server/*.ts|webui/server/*/*.ts|webui/server/*/*/*.ts)
      run_server_sync_io=1
      ;;
  esac
  case "$f" in
    webui/src/*.tsx|webui/src/*/*.tsx|webui/src/*/*/*.tsx|webui/src/*/*/*/*.tsx)
      run_webui_tsx_lints=1
      ;;
  esac
  case "$f" in
    .github/*) ;;
    *.yaml|*.yml)
      run_yaml_alias=1
      ;;
  esac
  case "$f" in
    docs/specs/*|docs/backlog/*|docs/governance/e2e-ledger.md|docs/qa/uat/INDEX.md)
      run_spec_docs=1
      ;;
  esac
  case "$f" in
    VERSION|docs/releases/*)
      run_version_ledger=1
      ;;
  esac
done <<EOF
$STAGED_FILES
EOF

if [ "$run_skip_ledger" = "1" ]; then
  npm run --silent lint:skip-ledger
fi

if [ "$run_server_sync_io" = "1" ]; then
  npm run --silent lint:server-sync-io
fi

if [ "$run_webui_tsx_lints" = "1" ]; then
  npm run --silent lint:url-driven-input
  npm --prefix webui run --silent lint:terminology
  npm --prefix webui run --silent lint:ia-boundary
  npm --prefix webui run --silent lint:copy-surfaces
  npm --prefix webui run --silent lint:button-feedback
fi

if [ "$run_yaml_alias" = "1" ]; then
  npm run --silent lint:yaml-alias
fi

if [ "$run_spec_docs" = "1" ]; then
  npm run --silent lint:status-vocab
  npm run --silent lint:e2e-ledger
fi

if [ "$run_version_ledger" = "1" ]; then
  npm run --silent lint:version
  npm run --silent lint:release-ledger
fi

echo "[pre-commit] PASS"
