{
  "schemaVersion": 1,
  "instanceId": "must-replace-instance",
  "profile": "k3s",
  "intent": "upgrade",
  "authState": "uninitialized",
  "credentialState": "new",
  "legacyBaselineReviewed": false,
  "context": "MUST-REPLACE-kubectl-context",
  "namespace": "lucy-test",
  "release": "lucy-starrocks",
  "deployment": "lucy",
  "service": "lucy",
  "pvcName": "lucy",
  "bootstrapSecret": "lucy-bootstrap",
  "access": "http",
  "webuiUrl": "http://MUST-REPLACE-host:8276",
  "publicMcpUrl": "http://MUST-REPLACE-host:8277/mcp",
  "namespaceUid": "MUST-REPLACE-namespace-uid",
  "deploymentUid": "MUST-REPLACE-deployment-uid",
  "pvcUid": "MUST-REPLACE-pvc-uid",
  "baselineImage": "MUST-REPLACE-current-image",
  "backup": { "method": "quiesced-pvc-tar" },
  "recovery": { "baselineImage": "MUST-REPLACE-current-image", "instructionsFile": "RECOVERY.md" },
  "offlineNodes": { "MUST-REPLACE-node": "local" },
  "values": {
    "fullnameOverride": "lucy",
    "image": { "repository": "docker.io/library/project-lucy", "tag": "MUST-REPLACE-image-tag", "digest": "", "pullPolicy": "Never" },
    "persistence": { "enabled": true, "existingClaim": "lucy", "size": "50Gi" },
    "service": { "type": "LoadBalancer", "webuiPort": 8276, "mcpPort": 8277 },
    "env": { "KTX_PROJECT_ROOT": "/data/lucy", "LUCY_CONTENT_ROOT": ".", "LUCY_PUBLIC_MCP_URL": "http://MUST-REPLACE-host:8277/mcp" },
    "existingSecret": "lucy-starrocks",
    "ingress": { "enabled": false },
    "security": { "access": "http" }
  }
}
